{
  "name": "remi-kampung-madya",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run apps/client",
    "e2e": "node apps/client/e2e/smoke.mjs",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/meja --noEmit && tsc -p apps/server --noEmit && tsc -p apps/client --noEmit",
    "dev:server": "npm run dev -w @remi/server",
    "dev:client": "npm run dev -w @remi/client",
    "build": "npm run build -w @remi/client && npm run build -w @remi/server",
    "start": "npm start -w @remi/server"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "20.14.5",
    "playwright-core": "1.56.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
